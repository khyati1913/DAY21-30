Q48: Write a program to print the following pattern:
1
12
123
1234
12345

/*
Sample Test Cases:
Input 1:

Output 1:
1
12
123
1234
12345

*/


#include <stdio.h>

int main() {
    int n = 5; // Number of rows

    // Outer loop for each row
    for (int i = 1; i <= n; i++) {
        // Inner loop for printing numbers in each row
        for (int j = 1; j <= i; j++) {
            printf("%d", j);
        }
        // Move to the next line after each row
        printf("\n");
    }

    return 0;
}
