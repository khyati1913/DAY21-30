Q46: Write a program to print the following pattern:
*****
*****
*****
*****
*****

/*
Sample Test Cases:
Input 1:

Output 1:
*****
*****
*****
*****
*****

*/


#include <stdio.h>

int main() {
    // Outer loop for 5 rows
    for (int i = 1; i <= 5; i++) {
        // Inner loop for 5 columns
        for (int j = 1; j <= 5; j++) {
            printf("*");
        }
        // Move to the next line after each row
        printf("\n");
    }
    return 0;
}
